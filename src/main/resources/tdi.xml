<?xml version="1.0" encoding="UTF-8"?>
<MetamergeConfig created="Phase 1" version="10.0.0">
	<Folder name="Connectors">
		<Connector name="jason.MCPServer">
			<SupportedModes>Server,Iterator</SupportedModes>
			<Configuration>
				<parameter name="connectorType">com.jason.di.connector.McpServerConnector</parameter>
				<parameter name="parserOption">Optional</parameter>
				<parameter name="endpointPath">/mcp</parameter>
				<parameter name="bindAddress">127.0.0.1</parameter>
				<parameter name="tcpPort">8443</parameter>
				<parameter name="useSSL">false</parameter>
				<parameter name="needClientAuth">false</parameter>
				<parameter name="authMode">bearer</parameter>
				<parameter name="bearerToken"></parameter>
				<parameter name="toolCatalog">[]</parameter>
				<parameter name="allowedOrigins"></parameter>
			</Configuration>
			<Schema name="Input">
				<SchemaItem>
					<Name>http.body</Name>
					<Syntax>String</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>$mcp.tool</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>$mcp.requestId</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>$mcp.protocolVersion</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>$mcp.arguments</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
			</Schema>
			<Schema name="Output">
				<SchemaItem>
					<Name>$mcp.result</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>$mcp.structured</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>$mcp.isError</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
			</Schema>
		</Connector>
	</Folder>
	<Folder name="Forms">
		<Form name="com.jason.di.connector.McpServerConnector">
			<TranslationFile>NLS/idi_conn_mcpserver</TranslationFile>
			<FormSectionNames>
				<ListItem>General</ListItem>
				<ListItem>Security</ListItem>
				<ListItem>Advanced</ListItem>
			</FormSectionNames>
			<FormSection name="General">
				<FormSectionNames>
					<ListItem>tcpPort</ListItem>
					<ListItem>bindAddress</ListItem>
					<ListItem>endpointPath</ListItem>
					<ListItem>toolCatalog</ListItem>
					<ListItem>$GLOBAL.userComment</ListItem>
					<ListItem>$GLOBAL.debug</ListItem>
				</FormSectionNames>
			</FormSection>
			<FormSection name="Security">
				<parameter name="title">Security</parameter>
				<parameter name="initiallyExpanded">true</parameter>
				<FormSectionNames>
					<ListItem>authMode</ListItem>
					<ListItem>bearerToken</ListItem>
					<ListItem>allowedOrigins</ListItem>
					<ListItem>useSSL</ListItem>
					<ListItem>needClientAuth</ListItem>
				</FormSectionNames>
			</FormSection>
			<FormSection name="Advanced">
				<parameter name="title">Advanced</parameter>
				<parameter name="initiallyExpanded">false</parameter>
				<FormSectionNames>
				</FormSectionNames>
			</FormSection>
			<FormItemNames>
				<ListItem>tcpPort</ListItem>
				<ListItem>bindAddress</ListItem>
				<ListItem>endpointPath</ListItem>
				<ListItem>toolCatalog</ListItem>
				<ListItem>authMode</ListItem>
				<ListItem>bearerToken</ListItem>
				<ListItem>allowedOrigins</ListItem>
				<ListItem>useSSL</ListItem>
				<ListItem>needClientAuth</ListItem>
				<ListItem>$GLOBAL.debug</ListItem>
			</FormItemNames>
			<FormItem name="tcpPort">
				<parameter name="Required">true</parameter>
				<parameter name="description">TCP_PORT_DESC</parameter>
				<parameter name="label">TCP_PORT_LABEL</parameter>
				<parameter name="syntax">Number</parameter>
			</FormItem>
			<FormItem name="bindAddress">
				<parameter name="description">BIND_ADDR_DESC</parameter>
				<parameter name="label">BIND_ADDR_LABEL</parameter>
			</FormItem>
			<FormItem name="endpointPath">
				<parameter name="description">ENDPOINT_PATH_DESC</parameter>
				<parameter name="label">ENDPOINT_PATH_LABEL</parameter>
			</FormItem>
			<FormItem name="toolCatalog">
				<parameter name="description">TOOL_CATALOG_DESC</parameter>
				<parameter name="label">TOOL_CATALOG_LABEL</parameter>
				<parameter name="syntax">textarea</parameter>
			</FormItem>
			<FormItem name="authMode">
				<Values>
					<ListItem>none</ListItem>
					<ListItem>bearer</ListItem>
					<ListItem>mtls</ListItem>
				</Values>
				<parameter name="description">AUTH_MODE_DESC</parameter>
				<parameter name="label">AUTH_MODE_LABEL</parameter>
				<parameter name="syntax">dropdown</parameter>
			</FormItem>
			<FormItem name="bearerToken">
				<parameter name="description">BEARER_TOKEN_DESC</parameter>
				<parameter name="label">BEARER_TOKEN_LABEL</parameter>
				<parameter name="syntax">PASSWORD</parameter>
			</FormItem>
			<FormItem name="allowedOrigins">
				<parameter name="description">ALLOWED_ORIGINS_DESC</parameter>
				<parameter name="label">ALLOWED_ORIGINS_LABEL</parameter>
			</FormItem>
			<FormItem name="useSSL">
				<parameter name="description">USE_SSL_DESC</parameter>
				<parameter name="label">USE_SSL_LABEL</parameter>
				<parameter name="syntax">BOOLEAN</parameter>
			</FormItem>
			<FormItem name="needClientAuth">
				<parameter name="description">CLIENT_AUTH_DESC</parameter>
				<parameter name="label">CLIENT_AUTH_LABEL</parameter>
				<parameter name="syntax">BOOLEAN</parameter>
			</FormItem>
			<parameter name="title">CONN_TITLE</parameter>
		</Form>
	</Folder>
</MetamergeConfig>
